From bd4ae6320c03e084590c0235ec1085c10c5f05cb Mon Sep 17 00:00:00 2001
From: Kha Nguyen <nguyentrongkha92@gmail.com>
Date: Fri, 13 Nov 2026 14:11:32 +0700
Subject: [PATCH] hide the function names garble did not hash

In tiny mode the linker keeps exported function names, which garble has
hashed, but the FIPS module is never obfuscated, and the type arguments of
a generic function spell out struct fields and package paths. Treat FIPS
names as unexported, and print type arguments as "[...]", as Go does.
The exported test now skips type arguments, whose dots are not the one
before the function's own name.
---
 cmd/link/internal/ld/pcln.go | 34 ++++++++++++++++++++++++++++++++--
 1 file changed, 32 insertions(+), 2 deletions(-)

diff --git a/cmd/link/internal/ld/pcln.go b/cmd/link/internal/ld/pcln.go
index b91b042..83ef9c1 100644
--- a/cmd/link/internal/ld/pcln.go
+++ b/cmd/link/internal/ld/pcln.go
@@ -375,8 +375,14 @@ func (state *pclntab) generateFuncnametab(ctxt *Link, funcs []loader.Sym) map[lo
 	// other unexported names with the smallest metadata-safe representation.
 	tinyFuncName := func(name string, funcID abi.FuncID) string {
 		name = runtimeMetadataFuncName(name, funcID)
-		if isExported(name) {
-			return name
+		// An exported name is kept only where garble hashed it: the FIPS
+		// module is never obfuscated. Type arguments are left out of the
+		// test, as a dot inside them is not the one before the function's
+		// own name, and out of what is kept, as they spell out struct
+		// fields and package paths; Go prints them as "[...]" too.
+		fips := strings.HasPrefix(name, "crypto/internal/fips140.") || strings.HasPrefix(name, "crypto/internal/fips140/")
+		if isExported(elideTypeArgs(name, "")) && !fips {
+			return elideTypeArgs(name, "[...]")
 		}
 		switch funcID {
 		case abi.FuncID_goexit, abi.FuncID_gopanic:
@@ -437,6 +443,30 @@ func (state *pclntab) generateFuncnametab(ctxt *Link, funcs []loader.Sym) map[lo
 	return nameOffsets
 }
 
+// elideTypeArgs returns name with each list of type arguments, a bracketed
+// group outside any other, replaced by with.
+func elideTypeArgs(name, with string) string {
+	if !strings.Contains(name, "[") {
+		return name
+	}
+	b := make([]byte, 0, len(name))
+	depth := 0
+	for i := 0; i < len(name); i++ {
+		switch c := name[i]; {
+		case c == '[':
+			if depth == 0 {
+				b = append(b, with...)
+			}
+			depth++
+		case c == ']' && depth > 0:
+			depth--
+		case depth == 0:
+			b = append(b, c)
+		}
+	}
+	return string(b)
+}
+
 // runtimeMetadataFuncName restores package prefixes used by runtime safety and
 // profiling checks while keeping each obfuscated function name unique. A few
 // runtime and reflect functions require their exact canonical names.
